# API Configuration Template for Streamlit Cloud
# Copy this to .streamlit/secrets.toml (local) or add in Streamlit Cloud dashboard

[api]
# DashScope API Key for Qwen models
DASHSCOPE_API_KEY = "your-api-key-here"

[models]
# Default model to use
default_model = "qwen-turbo-latest"

# Base URL for API
base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
